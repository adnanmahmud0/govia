# ==============================================================================
# GOVIA PRODUCTION ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# In production with GitHub Actions, this file is automatically generated 
# from your GitHub Repository Secrets and Variables during deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PROJECT_NAME=Govia
ENABLE_API_DOCS=true

# Internal container listening port and IP
PORT=5000
IP_ADDRESS=0.0.0.0

# Host Port Mappings on Shared Server (Isolated for Adnan)
HOST_API_PORT=9777
HOST_ADMIN_PORT=8777

# ------------------------------------------------------------------------------
# 2. MONGODB (Internal Isolated Docker Network)
# ------------------------------------------------------------------------------
# These credentials initialize MongoDB in the 'adnan-govia-mongo' container.
# Port 27017 is NEVER exposed to the public Internet or Host.
MONGO_INITDB_ROOT_USERNAME=goviaAdmin
MONGO_INITDB_ROOT_PASSWORD=your_mongodb_root_password_here
MONGO_INITDB_DATABASE=govia-db

# Internal connection URI used by the API container
DATABASE_URL=mongodb://goviaAdmin:your_mongodb_root_password_here@adnan-govia-mongo:27017/govia-db?authSource=admin

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
BCRYPT_SALT_ROUNDS=10

# Generate 64-character random strings (e.g. using openssl rand -hex 32)
JWT_SECRET=replace_with_super_secure_jwt_access_secret_64_characters
JWT_EXPIRE_IN=1h

JWT_REFRESH_SECRET=replace_with_super_secure_jwt_refresh_secret_64_characters
JWT_REFRESH_EXPIRE_IN=7d

# ------------------------------------------------------------------------------
# 4. INITIAL SUPER ADMIN SEED
# ------------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@govia.com
SUPER_ADMIN_PASSWORD=your_admin_password_here

# ------------------------------------------------------------------------------
# 5. ZOOM SERVER-TO-SERVER OAUTH API
# ------------------------------------------------------------------------------
ZOOM_ACCOUNT_ID=your_zoom_account_id_here
ZOOM_CLIENT_ID=your_zoom_client_id_here
ZOOM_CLIENT_SECRET=your_zoom_client_secret_here

# ------------------------------------------------------------------------------
# 6. GOVIA AI ASSISTANT (OpenRouter / OpenAI)
# ------------------------------------------------------------------------------
AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=your_openrouter_api_key_here
AI_MODEL_NAME=openrouter/free

# ------------------------------------------------------------------------------
# 7. EMAIL / SMTP NOTIFICATIONS (Gmail App Password)
# ------------------------------------------------------------------------------
EMAIL_FROM=adnan99mahmud@gmail.com
EMAIL_USER=adnan99mahmud@gmail.com
EMAIL_PORT=587
EMAIL_HOST=smtp.gmail.com
EMAIL_PASS=your_gmail_app_password_here

# ------------------------------------------------------------------------------
# 8. FRONTEND URLS (For Next.js Admin Dashboard)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://172.252.13.197:9777/api/v1
NEXT_PUBLIC_SOCKET_URL=http://172.252.13.197:9777

# ------------------------------------------------------------------------------
# 9. CLOUDFLARE TUNNEL (Optional for permanent domain routing)
# ------------------------------------------------------------------------------
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...
