    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.9.15",
    "openai": "^6.49.0",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
