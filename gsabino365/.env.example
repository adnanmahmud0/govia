# ─── Govia API Configuration ───────────────────────────────────────────────
# Copy this file to .env and fill in the correct values.
# NEVER commit the actual .env file to version control.

# Live Server
API_BASE_URL=https://adnan5000.binarybards.online/

# Android Emulator (Local Dev)
# API_BASE_URL=http://10.0.2.2:5000/api/v1

# iOS Simulator (Local Dev)
# API_BASE_URL=http://localhost:5000/api/v1

# Physical Device on WiFi (replace with your computer's LAN IP)
# API_BASE_URL=http://192.168.1.xxx:5000/api/v1

# ─── Environment ────────────────────────────────────────────────────────────
# Options: production | development
APP_ENV=production
